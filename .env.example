# Copy these settings into backend/.env and replace the example values.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/internship_portal
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding-at-least-12-characters

# Optional frontend API override; development defaults to the same-origin /api proxy.
# VITE_API_URL=http://localhost:5000/api
